---
import fallback from 'public/images/ecommerce-image.png';
import { Image } from 'astro:assets';

const { img, alt, title, tags, description, url } = Astro.props;
---

<div class="flex w-full flex-col rounded-xl shadow-sm">
  <div class="flex lg:min-h-[160px]">
    <Image src={img ?? fallback} alt={alt} class="h-full w-full rounded-t-xl" />
  </div>
  <div
    class="flex h-full flex-col justify-between rounded-b-xl bg-[#f1f1f1] p-4 dark:bg-black/80">
    <div class="flex w-full flex-col items-start">
      <h4
        class="text-black-text dark:text-white-text open-sans mb-3 text-lg font-semibold">
        {title}
      </h4>
      <div
        class="mb-4 shrink-0 rounded-xl bg-neutral-200 px-3 text-center dark:bg-neutral-800">
        <span
          class="text-black-text dark:text-white-text open-sans text-xs font-normal"
          >{tags}</span
        >
      </div>
      <p
        class="text-black-text dark:text-white-text open-sans mb-10 text-base font-normal">
        {description}
      </p>
    </div>
    {
      url && (
        <a
          href={url}
          target="_blank"
          class="btn ml-auto rounded-xl bg-neutral-100 px-4 py-2 text-neutral-800 dark:bg-neutral-900 dark:text-teal-50">
          View Project
        </a>
      )
    }
  </div>
</div>
