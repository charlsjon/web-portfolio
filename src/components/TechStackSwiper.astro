---
import { Image } from 'astro:assets';
import 'swiper/css';
import astro from 'public/images/astro-svgrepo-com.svg';
import js from 'public/images/js-svgrepo-com.svg';
---

<div class="swiper">
  <div class="swiper-wrapper">
    <div class="swiper-slide">
      <Image src={astro} alt="Astro icon" class="size-10" />
    </div>
    <div class="swiper-slide">
      <Image src={js} alt="JavaScript icon" class="size-10" />
    </div>
  </div>
</div>

<script>
  import { Swiper } from 'swiper';
  // Use a relative import for Swiper to work correctly with Astro
  // When using a framework like React or Vue you might need to import Swiper CSS here
  const swiper = new Swiper('.swiper', {
    direction: 'vertical',
    loop: true,
    slidesPerView: 'auto',
    autoplay: {
      delay: 3000, // Time in milliseconds between slide transitions (e.g., 3 seconds)
      disableOnInteraction: false, // Prevents autoplay from stopping when user interacts with the slider
      // Add other autoplay options as needed
    },
  });
</script>
