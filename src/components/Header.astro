---
import ThemeIcon from './ThemeIcon.astro';
---

<header class="navbar bg-isabelline dark:bg-raisin-black shadow-sm">
  <div class="navbar-start">
    <div class="dropdown">
      <div
        tabindex="0"
        role="button"
        class="active:border-black-text dark:active:border-white-text shrink-0 rounded-lg border border-transparent px-2 py-2 lg:hidden">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="stroke-raisin-black dark:stroke-isabelline h-5 w-5"
          fill="none"
          viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h8m-8 6h16"></path>
        </svg>
      </div>
      <ul
        tabindex="0"
        class="menu menu-sm dropdown-content rounded-box text-black-text dark:text-white-text z-1 mt-3 w-52 bg-neutral-50 p-2 shadow dark:bg-neutral-700">
        <li><a href="/">Home</a></li>
        <li><a href="/aboutme">About Me</a></li>
        <li><a href="/portfolio">Portfolio</a></li>
        <li><a>Contact</a></li>
      </ul>
    </div>
    <a
      class="ml-4 hidden cursor-pointer rounded-sm duration-150 ease-in-out hover:bg-white/40 lg:flex">
      <svg
        class="size-8"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 120 120">
        <rect width="120" height="120" rx="20" fill="none"></rect>
        <path
          d="M80 40a30 30 0 1 0 0 40"
          fill="none"
          stroke="#38bdf8"
          stroke-width="10"
          stroke-linecap="round"></path>
        <circle cx="40" cy="60" r="6" fill="#facc15"></circle>
      </svg>
    </a>
  </div>
  <div class="navbar-center flex">
    <ul class="menu menu-horizontal hidden px-1 lg:flex">
      <li class="text-[#171A1F] dark:text-[#f0f3f9]"><a href="/">Home</a></li>
      <li class="text-[#171A1F] dark:text-[#f0f3f9]">
        <a href="/aboutme">About Me</a>
      </li>
      <li class="text-[#171A1F] dark:text-[#f0f3f9]">
        <a href="/portfolio">Portfolio</a>
      </li>
      <li class="text-[#171A1F] dark:text-[#f0f3f9]"><a>Contact</a></li>
    </ul>
    <svg
      class="size-8 lg:hidden"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 120 120">
      <rect width="120" height="120" rx="20" fill="none"></rect>
      <path
        d="M80 40a30 30 0 1 0 0 40"
        fill="none"
        stroke="#38bdf8"
        stroke-width="10"
        stroke-linecap="round"></path>
      <circle cx="40" cy="60" r="6" fill="#facc15"></circle>
    </svg>
  </div>
  <div class="navbar-end">
    <ThemeIcon />
  </div>
</header>
