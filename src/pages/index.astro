---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeaturedProject from '@/components/FeaturedProject.astro';

import { Image } from 'astro:assets';
import heroImage from 'public/images/hero-image.png';
---

<BaseLayout>
  <div class="flex h-full w-full flex-col">
    <section class="flex flex-col px-4 py-6">
      <h1
        class="inter text-black-text dark:text-white-text mb-8 text-center text-4xl font-bold">
        Hello, I'm Charls
      </h1>
      <h2
        class="inter text-black-text dark:text-white-text mb-4 text-center text-3xl font-semibold">
        Front-end Web Developer
      </h2>
      <p
        class="open-sans text-neutral-text dark:text-white-text mb-6 text-center">
        Crafting beautiful and functional digital experiences. With a passion
        for clean design and intuitive interfaces, I bring ideas to life through
        thoughtful visual solutions and robust code.
      </p>
      <button
        class="open-sans btn btn-soft text-black-text bg-tertiary mb-4 rounded-xl border-0 text-lg"
        >View My Work</button
      >
      <button
        class="open-sans btn btn-soft mb-10 rounded-xl border-0 bg-neutral-500 text-lg text-teal-50 dark:bg-neutral-400"
        >Contact Me</button
      >
      <Image src={heroImage} alt="office-guy-coding" class="rounded-xl" />
    </section>
    <section
      class="flex flex-col gap-6 bg-neutral-200 px-4 py-8 dark:bg-neutral-800">
      <FeaturedProject
        img="ecommerce"
        alt="ecommerce"
        title="E-commerce Platform Redesign"
        tags="Web Development"
        description="Modernizing a retail platform for enhanced user experience and conversion, focusing on responsive design and intuitive navigation."
        link="/"
      />
      <FeaturedProject
        img="ecommerce"
        alt="ecommerce"
        title="Interactive SaaS Dashboard"
        tags="UI/UX Design"
        description="Building an intuitive data visualization tool for business analytics, featuring custom charts and real-time data updates."
        link="/"
      />
      <FeaturedProject
        img="ecommerce"
        alt="ecommerce"
        title="Personal Finance Mobile App"
        tags="Product Design"
        description="Designing a seamless mobile interface for a productivity application, incorporating gamification elements and secure transactions."
        link="/"
      />
    </section>
  </div>
</BaseLayout>
