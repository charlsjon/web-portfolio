---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Marquee from '@/components/Marquee.astro';
import aboutMeImg from 'public/images/1702305273756.jpg';
---

<BaseLayout>
  <main class="flex flex-col items-center px-4 py-8">
    <Image src={aboutMeImg} alt="About Me" class="mb-6 w-24 rounded-full" />
    <h1
      class="text-black-text dark:text-white-text inter mb-3 text-center text-2xl font-bold">
      Charlsjon Angelo Errazo
    </h1>
    <h6
      class="open-sans mb-6 text-center text-base font-normal text-neutral-600 dark:text-neutral-200">
      Computer Engineer | Front-end Web Developer
    </h6>
    <p
      class="text-black-text dark:text-white-text open-sans mb-8 text-center text-sm font-normal">
      Passionate about creating intuitive and engaging digital experiences,
      blending robust development with thoughtful design.
    </p>

    <section
      class="mb-8 flex flex-col rounded-xl bg-neutral-200 px-4 py-6 dark:bg-neutral-800">
      <h3
        class="inter text-black-text dark:text-white-text mb-4 text-xl font-semibold">
        About My Journey
      </h3>
      <p
        class="open-sans text-black-text dark:text-white-text text-base font-normal">
        My journey as a Front-End Web Developer began during my OJT, where I was
        introduced to the realities of building and maintaining software in a
        professional environment. Over the past three years and counting, I’ve
        learned not only how to build web applications, but also how to approach
        real-world problems, collaborate with a team, and continuously improve
        my work. Each project and challenge has helped me strengthen my
        technical skills while giving me a better understanding of how
        technology can solve practical problems. I know there is still a lot for
        me to learn, and I see that as an opportunity to keep growing. I’m
        constantly seeking new challenges and experiences that push me beyond my
        comfort zone and expand my skills as a developer.
      </p>
    </section>

    <section class="flex w-full flex-col items-center">
      <h1
        class="inter text-black-text dark:text-white-text mb-4 text-center text-xl font-semibold">
        Tech Stack
      </h1>
      <Marquee />
    </section>
  </main>
</BaseLayout>
