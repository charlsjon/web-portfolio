---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeaturedProject from '@/components/FeaturedProject.astro';
---

<BaseLayout>
  <div class="flex w-full flex-col px-4 py-6">
    <h1 class="inter mb-4 text-center text-2xl font-semibold">Projects</h1>
    <p
      class="text-black-text dark:text-white-text open-sans mb-10 text-center text-base font-normal">
      A curated collection of my recent creative works, showcasing diverse
      skills and design approaches in web and mobile applications.
    </p>
    <div class="flex w-full flex-col items-center gap-6">
      <FeaturedProject
        img="ecommerce"
        alt="ecommerce"
        title="Modern Web Redesign"
        tags="Web Development"
        description="A complete overhaul of a legacy e-commerce platform, focusing on user experience and conversion rates. Implemented with React and Tailwind CSS."
        link="/"
      />
      <FeaturedProject
        img="ecommerce"
        alt="ecommerce"
        title="Financial Tracking App"
        tags="Mobile App"
        description="Designed and developed a cross-platform mobile application for personal finance management, featuring intuitive charts and real-time data."
        link="/"
      />
      <FeaturedProject
        img="ecommerce"
        alt="ecommerce"
        title="Brand Identity Creation"
        tags="Branding"
        description="Developed a comprehensive brand identity package for a startup, including logo design, color palette, and typography guidelines."
        link="/"
      />
      <FeaturedProject
        img="ecommerce"
        alt="ecommerce"
        title="Interactive Data Dashboard"
        tags="Data Science"
        description="Created an interactive dashboard for visualizing complex business analytics, enabling users to explore trends and insights."
        link="/"
      />
      <FeaturedProject
        img="ecommerce"
        alt="ecommerce"
        title="UX Research Study"
        tags="UX/UI Design"
        description="Conducted extensive user research and usability testing to inform the redesign of a SaaS product, resulting in improved user satisfaction."
        link="/"
      />
      <FeaturedProject
        img="ecommerce"
        alt="ecommerce"
        title="E-commerce Platform"
        tags="Web Development"
        description="Developed a scalable e-commerce platform with a focus on seamless checkout experiences and robust inventory management."
        link="/"
      />
    </div>
  </div>
</BaseLayout>
